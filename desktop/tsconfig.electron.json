{
  "compilerOptions": {
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": ["node", "electron"]
  },
  "include": ["electron/main/**/*.ts", "electron/preload/**/*.ts", "electron.vite.config.ts"]
}
